# Daily Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key for AI Briefing
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Override default city
# WEATHER_HOME_CITY=Shanghai

# Optional: Stock symbols (comma-separated)
# FINANCE_STOCKS=SPY,QQQ,AAPL,MSFT

# Optional: Crypto symbols (comma-separated)
# FINANCE_CRYPTO=BTC-USD,ETH-USD,SOL-USD

# Optional: Enable/disable features (true/false)
# FINANCE_ENABLED=true
# AI_BRIEFING_ENABLED=true

# Optional: Reddit subreddits (comma-separated)
# REDDIT_SUBREDDITS=worldnews,technology,science

# Optional: News RSS feeds (comma-separated)
# NEWS_SOURCES=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml